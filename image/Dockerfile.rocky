# syntax=docker/dockerfile:1

ARG BASE_IMAGE=rockylinux:9
ARG KAIROS_INIT_VERSION=v0.8.5
ARG VERSION=v0.0.0
ARG MODEL=generic

FROM quay.io/kairos/kairos-init:${KAIROS_INIT_VERSION} AS kairos-init

FROM ${BASE_IMAGE} AS base-kairos
ARG VERSION
ARG MODEL
# Packages and FIPS cmdline have to land before -s init builds the UKI.
# The binary is mounted so it is not copied into a layer.
# Docker 24.0.6 / BuildKit v0.11.6 commits this as whiteouts of /.
# 29.8.1 / v0.33.0 does not. The minimum in between is unknown.
RUN --mount=type=bind,from=kairos-init,source=/kairos-init,target=/kairos-init \
    /kairos-init -l debug -s install -m "${MODEL}" --version "${VERSION}"

# Mount the directory so the script is not stored in a layer.
RUN --mount=type=bind,source=image,target=/mnt/image \
    ["/mnt/image/harden-el.sh"]

ARG TARGETARCH
ARG CRANE_VERSION=0.20.6
RUN arch="${TARGETARCH}"; [ "${arch}" = "amd64" ] && arch=x86_64; \
    curl -fsSL "https://github.com/google/go-containerregistry/releases/download/v${CRANE_VERSION}/go-containerregistry_Linux_${arch}.tar.gz" \
    | tar -xz -C /usr/bin crane

COPY image/prepare-capi-node /usr/sbin/prepare-capi-node
RUN chmod 0755 /usr/sbin/prepare-capi-node && mkdir -p /var/lib/extensions

# CIS/STIG remove rsync. dracut refuses to build the UKI without it.
RUN dnf -y install rsync && dnf clean all

RUN --mount=type=bind,from=kairos-init,source=/kairos-init,target=/kairos-init \
    /kairos-init -l debug -s init -m "${MODEL}" --version "${VERSION}"

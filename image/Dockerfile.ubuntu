# syntax=docker/dockerfile:1

ARG BASE_IMAGE=ubuntu:24.04
ARG KAIROS_INIT_VERSION=v0.8.5
ARG VERSION=v0.0.0
ARG MODEL=generic

FROM quay.io/kairos/kairos-init:${KAIROS_INIT_VERSION} AS kairos-init

FROM ${BASE_IMAGE} AS base-kairos
ARG VERSION
ARG MODEL
# Packages and FIPS cmdline have to land before -s init builds the UKI.
# The binary is mounted so it is not copied into a layer.
# Docker 24.0.6 / BuildKit v0.11.6 commits this as whiteouts of /.
# 29.8.1 / v0.33.0 does not. The minimum in between is unknown.
RUN --mount=type=bind,from=kairos-init,source=/kairos-init,target=/kairos-init \
    /kairos-init -l debug -s install -m "${MODEL}" --version "${VERSION}"

# Kubernetes nodes must forward pod traffic over both IP families. Persist the
# settings in the image; the runtime applies them during boot.
RUN mkdir -p /etc/sysctl.d && printf '%s\n' \
      'net.ipv4.ip_forward = 1' \
      'net.ipv6.conf.all.forwarding = 1' \
    > /etc/sysctl.d/99-kubernetes-cri.conf

# Kubernetes/containerd requires these modules; load them automatically at boot.
RUN mkdir -p /etc/modules-load.d && printf '%s\n' \
      'overlay' \
      'br_netfilter' \
    > /etc/modules-load.d/kubernetes.conf

# Mount the directory so the script is not stored in a layer.
RUN --mount=type=bind,source=image,target=/mnt/image \
    --mount=type=secret,id=ubuntu-pro-token,target=/run/secrets/ubuntu-pro-token \
    ["/mnt/image/harden-ubuntu.sh", "/run/secrets/ubuntu-pro-token"]

COPY image/prepare-capi-node /usr/sbin/prepare-capi-node
RUN chmod 0755 /usr/sbin/prepare-capi-node && mkdir -p /var/lib/kairos/extensions

# CIS/STIG remove rsync and install chrony. dracut needs rsync.
# chrony and systemd-timesyncd both provide time-daemon, so only one can be installed.
# kairos-init enables timesyncd, which means chrony has to be absent for that step.
RUN n=0; until apt-get update; do \
      n=$((n + 1)); \
      [ "${n}" -lt 5 ] || exit 1; \
      echo "apt-get update failed (attempt ${n}); retrying after mirror sync" >&2; \
      rm -rf /var/lib/apt/lists/*; \
      sleep $((n * 5)); \
    done \
 && apt-get install -y --no-install-recommends rsync systemd-timesyncd chrony- \
 && systemctl unmask systemd-timesyncd \
 && rm -rf /var/lib/apt/lists/*

RUN --mount=type=bind,from=kairos-init,source=/kairos-init,target=/kairos-init \
    /kairos-init -l debug -s init -m "${MODEL}" --version "${VERSION}"

# STIG time source is chrony. Purge timesyncd so its config goes too.
# chrony was only removed above, so its STIG config is still there.
RUN n=0; until apt-get update; do \
      n=$((n + 1)); \
      [ "${n}" -lt 5 ] || exit 1; \
      echo "apt-get update failed (attempt ${n}); retrying after mirror sync" >&2; \
      rm -rf /var/lib/apt/lists/*; \
      sleep $((n * 5)); \
    done \
 && apt-get purge -y systemd-timesyncd \
 && apt-get install -y --no-install-recommends chrony \
 && systemctl mask systemd-timesyncd \
 && systemctl enable chrony \
 && rm -rf /var/lib/apt/lists/*

#!/usr/bin/env bash
# Apply the known CRI + kubernetes sysext set so CABPK can run kubeadm.
# Usage: prepare-capi-node --registry REGISTRY --kubernetes-version vX.Y.Z [--os OS] [--arch ARCH] [--pause-tag TAG]
set -euo pipefail

EXTENSIONS_REL="var/lib/extensions"
SET_NAME="capi-node.set"
PAUSE_IMAGE_TAG="${PAUSE_IMAGE_TAG:-3.10}"

detect_os() {
  local text="${1:-$(cat /etc/os-release 2>/dev/null || true)}"
  local id="" version="" line
  while IFS= read -r line; do
    case "${line}" in
      ID=*) id="${line#ID=}" ;;
      VERSION_ID=*) version="${line#VERSION_ID=}" ;;
    esac
  done <<<"${text}"
  id="${id//\"/}"
  version="${version//\"/}"
  case "${id}" in
    ubuntu)
      printf 'ubuntu-%s\n' "${version}"
      ;;
    rocky | rocky_linux)
      printf 'rocky-%s\n' "${version%%.*}"
      ;;
    rhel)
      printf 'rhel-%s\n' "${version%%.*}"
      ;;
    *)
      printf 'unsupported os-release ID=%s VERSION_ID=%s\n' "${id}" "${version}" >&2
      return 1
      ;;
  esac
}

detect_arch() {
  local m="${1:-$(uname -m)}"
  case "${m}" in
    x86_64 | amd64) printf 'amd64\n' ;;
    aarch64 | arm64) printf 'arm64\n' ;;
    *)
      printf 'unsupported arch: %s\n' "${m}" >&2
      return 1
      ;;
  esac
}

cri_ref() {
  printf '%s/cri:%s-%s\n' "$1" "$2" "$3"
}

kubernetes_ref() {
  printf '%s/kubernetes:%s-%s\n' "$1" "$2" "$3"
}

set_file_contents() {
  local registry="$1" os="$2" arch="$3" ver="$4"
  printf 'registry=%s\nos=%s\narch=%s\nkubernetes=%s\n' "${registry}" "${os}" "${arch}" "${ver}"
}

_set_field() {
  local setfile="$1" key="$2" line
  [[ -f "${setfile}" ]] || return 1
  line="$(grep -E "^${key}=" "${setfile}" || true)"
  [[ -n "${line}" ]] || return 1
  printf '%s\n' "${line#"${key}="}"
}

already_applied() {
  local setfile="$1" registry="$2" os="$3" arch="$4" ver="$5"
  [[ -f "${setfile}" ]] || return 1
  [[ "$(cat "${setfile}")" == "$(set_file_contents "${registry}" "${os}" "${arch}" "${ver}")" ]]
}

_root() {
  printf '%s\n' "${PREPARE_CAPI_NODE_ROOT:-}"
}

_log() {
  [[ -n "${PREPARE_CAPI_NODE_LOG:-}" ]] || return 0
  printf '%s\n' "$1" >>"${PREPARE_CAPI_NODE_LOG}"
}

_extensions_dir() {
  local r
  r="$(_root)"
  if [[ -n "${r}" ]]; then
    printf '%s/%s\n' "${r}" "${EXTENSIONS_REL}"
  else
    printf '/%s\n' "${EXTENSIONS_REL}"
  fi
}

_pull_sysext() {
  local ref="$1" dest="$2"
  _log "pull ${ref}"
  if [[ -n "${PREPARE_CAPI_NODE_ROOT:-}" ]]; then
    printf 'test-sysext %s\n' "${ref}" >"${dest}"
    return 0
  fi
  local tmp
  tmp="$(mktemp -d)"
  if ! crane export "${ref}" - | tar -x -C "${tmp}" extension.raw; then
    rm -rf "${tmp}"
    return 1
  fi
  mv "${tmp}/extension.raw" "${dest}"
  rm -rf "${tmp}"
}

_refresh_sysext() {
  if [[ -n "${PREPARE_CAPI_NODE_ROOT:-}" ]]; then
    return 0
  fi
  systemd-sysext refresh
}

_read_pause_tag() {
  local f r
  r="$(_root)"
  if [[ -n "${r}" ]]; then
    f="${r}/usr/lib/kairos/pause-tag"
  else
    f=/usr/lib/kairos/pause-tag
  fi
  if [[ -f "${f}" ]]; then
    PAUSE_IMAGE_TAG="$(tr -d '[:space:]' <"${f}")"
  fi
}

_sandbox_image() {
  local registry="$1"
  printf '%s/pause:%s\n' "${registry}" "${PAUSE_IMAGE_TAG}"
}

_containerd_dir() {
  local r
  r="$(_root)"
  if [[ -n "${r}" ]]; then
    printf '%s/etc/containerd\n' "${r}"
  else
    printf '/etc/containerd\n'
  fi
}

_write_containerd_sandbox() {
  local registry="$1" dir img
  dir="$(_containerd_dir)"
  img="$(_sandbox_image "${registry}")"
  mkdir -p "${dir}/conf.d"
  if [[ -z "${PREPARE_CAPI_NODE_ROOT:-}" ]] && command -v containerd >/dev/null 2>&1; then
    containerd config default >"${dir}/config.toml"
  fi
  if [[ ! -f "${dir}/config.toml" ]] || ! grep -q 'conf.d' "${dir}/config.toml"; then
    cat >"${dir}/config.toml" <<'EOF'
version = 3
imports = ["/etc/containerd/conf.d/*.toml"]
EOF
  fi
  cat >"${dir}/conf.d/capi-sandbox.toml" <<EOF
version = 3

[plugins.'io.containerd.cri.v1.images'.pinned_images]
  sandbox = "${img}"
EOF
}

_stop_kubelet() {
  _log "stop kubelet"
  [[ -n "${PREPARE_CAPI_NODE_ROOT:-}" ]] && return 0
  systemctl stop kubelet 2>/dev/null || true
}

_stop_containerd() {
  _log "stop containerd"
  [[ -n "${PREPARE_CAPI_NODE_ROOT:-}" ]] && return 0
  systemctl stop containerd 2>/dev/null || true
}

_start_runtime() {
  _log "start runtime"
  [[ -n "${PREPARE_CAPI_NODE_ROOT:-}" ]] && return 0
  systemctl enable --now containerd
  systemctl enable --now kubelet
}

_restart_if_stopped() {
  [[ "${_stopped:-0}" -eq 1 ]] || return 0
  _start_runtime || true
}

prepare-capi-node-main() {
  local registry="" ver="" os="" arch="" pause_flag=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --registry) registry="${2:-}"; shift 2 ;;
      --kubernetes-version) ver="${2:-}"; shift 2 ;;
      --os) os="${2:-}"; shift 2 ;;
      --arch) arch="${2:-}"; shift 2 ;;
      --pause-tag) pause_flag="${2:-}"; shift 2 ;;
      -h | --help)
        printf 'usage: prepare-capi-node --registry REGISTRY --kubernetes-version vX.Y.Z [--os OS] [--arch ARCH] [--pause-tag TAG]\n' >&2
        return 2
        ;;
      *)
        printf 'unknown flag: %s\n' "$1" >&2
        return 2
        ;;
    esac
  done
  if [[ -n "${pause_flag}" ]]; then
    PAUSE_IMAGE_TAG="${pause_flag}"
  fi
  if [[ -z "${registry}" ]]; then
    printf 'missing --registry (imageRepository prefix, e.g. harbor.example.com/project)\n' >&2
    return 2
  fi
  if [[ -z "${ver}" ]]; then
    printf 'missing --kubernetes-version\n' >&2
    return 2
  fi
  if [[ -z "${os}" ]]; then
    os="$(detect_os)"
  fi
  if [[ -z "${arch}" ]]; then
    arch="$(detect_arch)"
  fi

  local ext setfile cri_dest k8s_dest
  ext="$(_extensions_dir)"
  mkdir -p "${ext}"
  setfile="${ext}/${SET_NAME}"
  cri_dest="${ext}/cri.raw"
  k8s_dest="${ext}/kubernetes.raw"

  if already_applied "${setfile}" "${registry}" "${os}" "${arch}" "${ver}"; then
    printf 'prepare-capi-node: already applied %s %s %s\n' "${os}" "${arch}" "${ver}"
    return 0
  fi

  local cri_changing=0 prev_reg prev_os prev_arch
  prev_reg="$(_set_field "${setfile}" registry || true)"
  prev_os="$(_set_field "${setfile}" os || true)"
  prev_arch="$(_set_field "${setfile}" arch || true)"
  if [[ ! -f "${setfile}" || "${prev_reg}" != "${registry}" || "${prev_os}" != "${os}" || "${prev_arch}" != "${arch}" ]]; then
    cri_changing=1
  fi

  # Pull beside the live files before stopping anything. A failed pull must
  # leave kubelet running.
  if [[ "${cri_changing}" -eq 1 ]]; then
    _pull_sysext "$(cri_ref "${registry}" "${os}" "${arch}")" "${cri_dest}.new" || return 1
  fi
  _pull_sysext "$(kubernetes_ref "${registry}" "${ver}" "${arch}")" "${k8s_dest}.new" || {
    rm -f "${cri_dest}.new"
    return 1
  }

  _stopped=0
  _stop_kubelet
  _stopped=1
  if [[ "${cri_changing}" -eq 1 ]]; then
    _stop_containerd
  fi
  if [[ "${cri_changing}" -eq 1 ]]; then
    mv "${cri_dest}.new" "${cri_dest}" || {
      _restart_if_stopped
      return 1
    }
  fi
  mv "${k8s_dest}.new" "${k8s_dest}" || {
    _restart_if_stopped
    return 1
  }
  set_file_contents "${registry}" "${os}" "${arch}" "${ver}" >"${setfile}"
  _refresh_sysext || {
    _restart_if_stopped
    return 1
  }
  if [[ -z "${pause_flag}" ]]; then
    _read_pause_tag
  fi
  _write_containerd_sandbox "${registry}"
  _start_runtime || return 1
  _stopped=0
  printf 'prepare-capi-node: applied cri=%s kubernetes=%s\n' "$(cri_ref "${registry}" "${os}" "${arch}")" "$(kubernetes_ref "${registry}" "${ver}" "${arch}")"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  prepare-capi-node-main "$@"
fi

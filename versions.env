# Pinned versions for the CAPI Kairos FIPS factory.
# Override any of these in the environment.

KUBERNETES_VERSION_OLD="${KUBERNETES_VERSION_OLD:-v1.36.5}"
KUBERNETES_VERSION_NEW="${KUBERNETES_VERSION_NEW:-v1.37.1}"
CONTAINERD_VERSION="${CONTAINERD_VERSION:-2.4.0}"
RUNC_VERSION="${RUNC_VERSION:-1.5.1}"
CNI_PLUGINS_VERSION="${CNI_PLUGINS_VERSION:-1.9.1}"
# kubelet.service and 10-kubeadm.conf from kubernetes/release.
KUBE_RELEASE_VERSION="${KUBE_RELEASE_VERSION:-v0.21.0}"
KAIROS_INIT_VERSION="${KAIROS_INIT_VERSION:-v0.17.3}"
# kairos-init --version must be semver. git describe (e55ff91-dirty) is not.
KAIROS_IMAGE_VERSION="${KAIROS_IMAGE_VERSION:-v0.1.0}"
AURORABOOT_IMAGE="${AURORABOOT_IMAGE:-quay.io/kairos/auroraboot:v0.27.1}"
PAUSE_IMAGE_TAG="${PAUSE_IMAGE_TAG:-3.10.2}"
KAIROS_KIND_CLUSTER_NAME="${KAIROS_KIND_CLUSTER_NAME:-kairos-demo}"
# auto: macOS + `container` CLI uses Apple container for image builds and
# `container k8s` for the management cluster. docker and kind otherwise.
# AuroraBoot pulls the sysext rootfs. It is not given a Docker socket.
# Multi-arch indexes are published with crane.
KAIROS_BUILDER="${KAIROS_BUILDER:-auto}"
KAIROS_MGMT="${KAIROS_MGMT:-auto}"
# v0.2.2 OSArtifact: spec.image.ref and spec.artifacts.cloudImage / cloudConfigRef.
KAIROS_OPERATOR_REF="${KAIROS_OPERATOR_REF:-v0.2.2}"
# Go that provides GOFIPS140=certified (1.26.3+). Dockerfiles default to the same.
GO_VERSION="${GO_VERSION:-1.27.1}"
# Latest 1.13 patch. clusterctl init installs this even if the binary is older.
CAPI_VERSION="${CAPI_VERSION:-v1.13.6}"
CAPI_EXTENSION_IMAGE="${CAPI_EXTENSION_IMAGE:-kairos-inplace:dev}"
NUTANIX_CCM_REPO="${NUTANIX_CCM_REPO:-https://nutanix-cloud-native.github.io/cloud-provider-nutanix}"
NUTANIX_CCM_CHART="${NUTANIX_CCM_CHART:-nutanix-cloud-provider}"

OSES="${OSES:-ubuntu-22.04 ubuntu-24.04 rocky-9}"
ARCHES="${ARCHES:-amd64 arm64}"

# Pinned versions for the CAPI Kairos FIPS factory.
# Override any of these in the environment.

KUBERNETES_VERSION_OLD="${KUBERNETES_VERSION_OLD:-v1.35.8}"
KUBERNETES_VERSION_NEW="${KUBERNETES_VERSION_NEW:-v1.36.4}"
CONTAINERD_VERSION="${CONTAINERD_VERSION:-2.2.2}"
RUNC_VERSION="${RUNC_VERSION:-1.4.2}"
CNI_PLUGINS_VERSION="${CNI_PLUGINS_VERSION:-1.9.1}"
KAIROS_INIT_VERSION="${KAIROS_INIT_VERSION:-v0.8.5}"
AURORABOOT_IMAGE="${AURORABOOT_IMAGE:-quay.io/kairos/auroraboot:v0.26.2}"
PAUSE_IMAGE_TAG="${PAUSE_IMAGE_TAG:-3.10}"
KAIROS_KIND_CLUSTER_NAME="${KAIROS_KIND_CLUSTER_NAME:-kairos-demo}"

OSES="${OSES:-ubuntu-22.04 ubuntu-24.04 rocky-9}"
ARCHES="${ARCHES:-amd64 arm64}"

# syntax=docker/dockerfile:1
# Dynamically linked containerd against the target OS, plus runc + CNI.

ARG BASE_IMAGE
ARG CONTAINERD_VERSION=2.2.2
ARG RUNC_VERSION=1.4.2
ARG CNI_PLUGINS_VERSION=1.9.1
ARG GO_VERSION=1.25.10

FROM golang:${GO_VERSION} AS gobuild
FROM ${BASE_IMAGE} AS build
ARG CONTAINERD_VERSION
ARG RUNC_VERSION
ARG CNI_PLUGINS_VERSION
ARG TARGETARCH
ARG GO_VERSION=1.25.10
COPY --from=gobuild /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH GOFIPS140=certified CGO_ENABLED=1
RUN if command -v apt-get >/dev/null; then \
      apt-get update && apt-get install -y --no-install-recommends git make gcc libc6-dev libseccomp-dev pkg-config curl ca-certificates; \
    else \
      dnf -y install git make gcc libseccomp-devel pkgconfig curl ca-certificates; \
    fi

WORKDIR /src
RUN git clone --depth 1 --branch "v${CONTAINERD_VERSION}" https://github.com/containerd/containerd.git
WORKDIR /src/containerd
RUN make bin/containerd bin/containerd-shim-runc-v2 bin/ctr

WORKDIR /src
RUN curl -fsSL "https://github.com/opencontainers/runc/releases/download/v${RUNC_VERSION}/runc.${TARGETARCH}" -o /usr/local/bin/runc && chmod +x /usr/local/bin/runc
RUN mkdir -p /opt/cni/bin && \
    curl -fsSL "https://github.com/containernetworking/plugins/releases/download/v${CNI_PLUGINS_VERSION}/cni-plugins-linux-${TARGETARCH}-v${CNI_PLUGINS_VERSION}.tgz" \
    | tar -xz -C /opt/cni/bin

FROM ${BASE_IMAGE}
COPY --from=build /src/containerd/bin/containerd /usr/bin/containerd
COPY --from=build /src/containerd/bin/containerd-shim-runc-v2 /usr/bin/containerd-shim-runc-v2
COPY --from=build /src/containerd/bin/ctr /usr/bin/ctr
COPY --from=build /usr/local/bin/runc /usr/bin/runc
COPY --from=build /opt/cni/bin /opt/cni/bin
COPY sysexts/containerd.service /usr/lib/systemd/system/containerd.service
RUN mkdir -p /etc/systemd/system/multi-user.target.wants && \
    ln -sf /usr/lib/systemd/system/containerd.service /etc/systemd/system/multi-user.target.wants/containerd.service
